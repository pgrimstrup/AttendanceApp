<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AttendanceBlazor.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

@code {
        public static bool IsDevelopment()
#if DEBUG
            => true;
#else
            => false;
#endif
}

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script type="text/javascript">
        function downloadFile(fileName, contentType, byteArray) {
            const blob = new Blob([byteArray], { type: contentType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            a.click();
            URL.revokeObjectURL(url);
        }

        function authCodeKeyDown(currentInput, prev, event){
            if(event.ctrlKey && event.keyCode == 86){
                // Ctrl+V
                navigator.clipboard.readText().then(text => {
                    text = text.replaceAll(" ", "");

                    if(/[0-9]{8}/.test(text)){
                        console.log("Paste Matching Text", text);
                        document.getElementById("ac1").value = text[0];
                        document.getElementById("ac1").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac2").value = text[1];
                        document.getElementById("ac2").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac3").value = text[2];
                        document.getElementById("ac3").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac4").value = text[3];
                        document.getElementById("ac4").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac5").value = text[4];
                        document.getElementById("ac5").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac6").value = text[5];
                        document.getElementById("ac6").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac7").value = text[6];
                        document.getElementById("ac7").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac8").value = text[7];
                        document.getElementById("ac8").dispatchEvent(new Event('change', { bubbles: true }));
                        document.getElementById("ac8").focus();
                    } else {
                        console.log("Paste Text did not match", text);
                    }
                });
            }
            if(event.keyCode == 8){
                // Backspace
                if(currentInput.value.length <= 0){
                    const prevInput = document.getElementById(prev);
                    if(prevInput){
                        prevInput.value = "";
                        prevInput.dispatchEvent(new Event('change', { bubbles: true }));
                        prevInput.focus();
                    }
                }
            }
            return true;
        }



        function authCodeKeyUp(currentInput, next, event){
            if(currentInput.value.length >= currentInput.maxLength){
                const nextInput = document.getElementById(next);
                if(nextInput){
                    nextInput.focus();
                    nextInput.select();
                }else{
                    currentInput.select();
                    currentInput.dispatchEvent(new Event('change', { bubbles: true }));
                }
            }else{
                currentInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
            return true;
        }

    </script>
</body>

</html>
