@page "/Details/{PNZNumber}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAttendanceManager AttendanceManager

<PageTitle>RRGC Attendance Details for @PNZNumber</PageTitle>

@code {

    [Parameter]
    public string PNZNumber { get; set; } = string.Empty;

    public DetailsViewModel Model { get; set; } = new(null, null);

    public AwayEventViewModel AwayEvent { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Model = await LoadModelData(null, PNZNumber);
        ClearAwayEvent();
    }


    private async Task<DetailsViewModel> LoadModelData(int? year, string? pnzNumber)
    {
        var model = new DetailsViewModel(year, pnzNumber);

        var attendance = await AttendanceManager.GetAttendanceAsync(Model.StartDate, Model.EndDate, PNZNumber);
        foreach (var record in attendance)
        {
            if (record.EntryTime == null && record.ExitTime == null && record.RangeTime == null && !record.IsAwayEvent)
            {
                // Ignore records with no times on this view
                continue;
            }

            model.Attendance.Add(new AttendanceViewModel(record));
        }

        if (model.Attendance.Count > 0)
        {
            var cardNumbers = model.Attendance.Select(a => a.CardNumber).Distinct().ToArray();
            var swipeEvents = await AttendanceManager.GetSwipeCardEventsAsync(Model.StartDate, Model.EndDate, cardNumbers);
            model.SwipeEvents.AddRange(swipeEvents);
        }

        model.Attendance.Sort((a, b) => a.EventDate.CompareTo(b.EventDate));

        return model;
    }

    private string ShortenName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return name;

        return $"{parts[0]} {parts[^1].Substring(0, 1)}";
    }

    private async Task ExcludeEvent(AttendanceViewModel record)
    {
        await AttendanceManager.ExcludedAsync(record.PersonId, DateOnly.FromDateTime(record.EventDate), record.IsOnRange);
        Model = await LoadModelData(Model.Year, PNZNumber);
        StateHasChanged();
    }

    private async Task IncludeEvent(AttendanceViewModel record)
    {
        await AttendanceManager.IncludedAsync(record.PersonId, DateOnly.FromDateTime(record.EventDate), record.IsOnRange);
        Model = await LoadModelData(Model.Year, PNZNumber);
        StateHasChanged();
    }

    private void ClearAwayEvent()
    {
        AwayEvent = new AwayEventViewModel{
            StartDate = DateTime.Today.AddDays(-1),
            EndDate = DateTime.Today.AddDays(-1)
        };
    }

    private async Task SaveAwayEvent()
    {
        await AttendanceManager.AddAwayEvent(Model.PNZNumber, AwayEvent.Entity);
        ClearAwayEvent();
        Model = await LoadModelData(Model.Year, Model.PNZNumber);
        StateHasChanged();
    }

    private async Task DeleteAwayEvent(AttendanceViewModel record)
    {
        await AttendanceManager.DeleteAwayEvent(record.PersonId, DateOnly.FromDateTime(record.EventDate), record.AwayLocation, record.AwayEventName);
        Model = await LoadModelData(Model.Year, Model.PNZNumber);
        StateHasChanged();
    }
}

<h2 style="text-align:center">Attendance details for PNZ Number @PNZNumber</h2>
<h3 style="text-align: center">from @Model.StartDate.ToString("d MMMM yyyy") to @Model.EndDate.ToString("d MMMM yyyy")</h3>
<div style="text-align: center">Last updated @Model.LastUpdated.ToString("dd/MM/yyyy h:mm tt")</div>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th style="text-align:center">Match days</th>
            <th>Entry time</th>
            <th>On Range</th>
            <th>Exit time</th>
            <th style="text-align:center">Counted</th>
            <th>Time on range</th>
            <th>Card number</th>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var record in Model.Attendance)
        {
            <tr>
                <td>@record.EventTitle</td>
                @if (record.IsAwayEvent)
                {
                    <td style="text-align:center"><i class="bi bi-duffle" style="font-size: 18px" /></td>
                    <td colspan="3">@($"{record.AwayLocation} - {record.AwayEventName}".Trim(' ','-'))</td>
                }
                else
                {
                    <td style="text-align:center">
                        @if (record.IsPistolDay && !record.IsClosedDay)
                        {
                            <i class="bi bi-calendar-check" style="font-size: 18px" />
                        }
                    </td>
                    <td>@record.EntryTime</td>
                    @if (record.IsPistolDay)
                    {
                        if (record.IsClosedDay)
                        {
                            <td class="text-warning"><i class="bi bi-lock-fill" style="font-size: 18px" /><span class="small"> Range Closed</span></td>
                        }
                        else if (record.IsIncluded)
                        {
                            <td class="text-success"><i class="bi bi-person-check" style="font-size: 18px" /><span class="small"> Counted</span></td>
                        }
                        else if (record.IsExcluded)
                        {
                            <td class="text-danger"><i class="bi bi-x-circle" style="font-size: 18px" /><span class="small"> Excluded</span></td>
                        }
                        else
                        {
                            <td>@record.RangeTime</td>
                        }
                    }
                    else
                    {
                        <td>@record.RangeTime</td>
                    }
                    <td>@record.ExitTime</td>
                }
                <td style="text-align:center">
                    @if (record.IsCounted)
                    {
                        <i class="bi bi-check2-square" style="font-size: 18px" />
                    }
                </td>

                @if (record.IsAwayEvent)
                {
                    <td>Away</td>
                    <td></td>
                }
                else
                {
                    <td>@record.TimeOnRange</td>
                    <td>@record.CardNumber</td>
                }
                <td>@record.Name</td>
                <td>
                    @if(record.IsAwayEvent)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="async () => await DeleteAwayEvent(record)">Delete</button>
                    }
                    else if (record.IsPistolDay && !record.IsClosedDay && !record.IsCounted)
                    {
                        <button class="btn btn-sm btn-success" @onclick="async () => await IncludeEvent(record)">Include</button>
                    }
                    else if (record.IsPistolDay && !record.IsClosedDay && record.IsCounted)
                    {
                        <button class="btn btn-sm btn-warning" @onclick="async () => await ExcludeEvent(record)">Exclude</button>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th style="text-align:end">Number of match days attended:</th>
            <th style="text-align:center">@Model.TotalMatchDays</th>
            <th style="text-align:end" colspan="3">Number of events counted:</th>
            <th style="text-align:center">@Model.TotalEventsCounted</th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </tfoot>
</table>

<hr />
<h2 style="text-align: center" class="mt-5">Add an Away Match</h2>
<div class="row">
    <!-- Location -->
    <div class="col-3">
        <label for="location" class="col-form-label">Club Name</label>
        <InputText id="location" class="form-control" @bind-Value="AwayEvent.Location" placeholder="Enter location" />
    </div>

    <!-- Event Name -->
    <div class="col-3">
        <label for="eventName" class="col-form-label">Event Name</label>
        <InputText id="eventName" class="form-control" @bind-Value="AwayEvent.EventName" placeholder="Enter event name" />
    </div>

    <!-- Start Date -->
    <div class="col-2">
        <label for="startDate" class="col-form-label">Start Date</label>
        <InputDate id="startDate" class="form-control" @bind-Value="AwayEvent.StartDate" />
    </div>

    <!-- End Date -->
    <div class="col-2">
        <label for="endDate" class="col-form-label">End Date</label>
        <InputDate id="endDate" class="form-control" @bind-Value="AwayEvent.EndDate" />
    </div>

</div>
<div class="row my-1" >
    <div class="col-10">
        <InputText class="form-control" @bind-Value="AwayEvent.Notes" placeholder="Enter notes"></InputText>
    </div>
    <!-- Buttons -->
    <div style="white-space:nowrap; width:1px;">
        <button type="button" class="btn btn-secondary" @onclick="ClearAwayEvent">Clear</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAwayEvent">Save</button>
    </div>
</div>


<hr />
<h2 style="text-align: center" class="mt-5">All Activity</h2>
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Card Number</th>
            <th>Card Name (internal use)</th>
            <th>Member Name</th>
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.SwipeEvents)
        {
            <tr>
                <td>@e.EventTime.ToString("dddd, d MMMM")</td>
                <td>@e.EventTime.ToString("h:mm tt")</td>
                <td>@e.CardNumber</td>
                <td>@e.CardUserName</td>
                <td>@ShortenName(e.CardInfo1)</td>
                <td>@e.Location</td>
            </tr>
        }
    </tbody>
</table>
