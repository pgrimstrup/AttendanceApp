@page "/"
@rendermode InteractiveServer
@inject IAttendanceManager AttendanceManager
@inject ICalendarManager CalendarManager
@inject IEntraPassImporter EntraPassImporter

@code {

    public HomeViewModel Model { get; set; } = new(null);

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Model = await LoadModelData(null);
    }

    public void Dispose()
    {
    }


    private async Task<HomeViewModel> LoadModelData(int? year)
    {
        var model = new HomeViewModel(year);

        model.LastUpdated = await EntraPassImporter.GetLastImportDateTimeAsync();
        // Convert months 7 to 6 to a number in the range 0 to 11.
        model.WarningThreshold = ((model.LastUpdated.Month + 5) % 12) / 2;
        model.RequiredCount = 12;

        var days = await CalendarManager.GetCalendarDays(model.LastUpdated);
        var when = DateOnly.FromDateTime(model.LastUpdated);
        model.MatchDaysDone = days.Count(days => days.Date <= when && ((days.IsPistolDay && !days.IsClosedOverride && !days.IsClosedDay) || days.IsOpenOverride));
        model.MatchDaysRemaining = days.Count(days => days.Date > when && ((days.IsPistolDay && !days.IsClosedOverride && !days.IsClosedDay) || days.IsOpenOverride));

        var summaries = AttendanceManager.GetAttendanceSummariesAsync(Model.StartDate, Model.EndDate);
        foreach (var summary in await summaries)
        {
            switch (summary.Sections)
            {
                case SectionTags.CAS:
                    model.CAS.Add(summary);
                    break;
                case SectionTags.IPSC:
                    model.IPSC.Add(summary);
                    break;
                case SectionTags.ISSF:
                    model.ISSF.Add(summary);
                    break;
                default:
                    model.MultiGun.Add(summary);
                    break;
            }
        }

        model.CAS.Sort((a, b) => a.SortCode.CompareTo(b.SortCode));
        model.IPSC.Sort((a, b) => a.SortCode.CompareTo(b.SortCode));
        model.ISSF.Sort((a, b) => a.SortCode.CompareTo(b.SortCode));
        model.MultiGun.Sort((a, b) => a.SortCode.CompareTo(b.SortCode));

        return model;
    }

    private string GetStatusClass(AttendanceSummaryRecord item)
    {
        if (item.Count < Model.WarningThreshold)
        {
            if (Model.MatchDaysRemaining <= (Model.RequiredCount - item.Count) * 2)
            return "bi bi-exclamation-triangle-fill pnz-risk";

            if (Model.MatchDaysRemaining <= (Model.RequiredCount - item.Count) * 4)
                return "bi bi-exclamation-triangle pnz-risk";

            return "bi bi-exclamation-triangle pnz-warning";
        }

        if (item.Count >= Model.RequiredCount)
            return "bi bi-check2-square pnz-complete";

        return "";
    }

    private string GetStatusHint(AttendanceSummaryRecord item)
    {
        if (item.Count < Model.WarningThreshold)
        {
            if (Model.MatchDaysRemaining <= (Model.RequiredCount - item.Count) * 2)
                return "You are at extreme risk of failing to meet your B Endorsement obligations";

            if (Model.MatchDaysRemaining <= (Model.RequiredCount - item.Count) * 4)
                return "You are at risk of failing to meet your B Endorsement obligations";

            return "You will need to catch up to meet your B Endorsement obligations";
        }
        if (item.Count >= Model.RequiredCount)
            return "You have met your B Endorsement obligations for the year";
        return "";
    }
}

<PageTitle>RRGC Attendance</PageTitle>


<div>
    <h2 style="text-align:center">Current @Model.YearTitle shoot counts, by PNZ number, by Section</h2>
    <h3 style="text-align: center">from @Model.StartDate.ToString("d MMMM yyyy") to @Model.LastUpdated.AddDays(-1).ToString("d MMMM yyyy")</h3>
    <div style="text-align: center">There have been <b>@Model.MatchDaysDone</b> match days to date, with <b>@Model.MatchDaysRemaining</b> match days remaining</div>
</div>
<div class="row">
    <div class="col-3">
        <table class="table table-sm table-borderless table-striped text-center" width="100%">
            <thead>
                <tr>
                    <th colspan="3" align="center"><h3>Multi Gun/Other</h3></th>
                </tr>
                <tr>
                    <th>PNZ #</th>
                    <th>Totals</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MultiGun.Count == 0)
                {
                    <tr>
                        <td colspan="3" align="center">
                            <div class="bg-info text-white m-3">No data</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.MultiGun)
                    {
                        <tr>
                            <td>
                                <AuthorizeView Roles="Admin">
                                    <Authorized>
                                        <NavLink href="@("/pnznumber/" + Uri.EscapeDataString(item.PNZNumber))">@item.PNZNumber</NavLink>
                                    </Authorized>
                                    <NotAuthorized>
                                        <b>@item.PNZNumber</b>
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td>@item.Count</td>
                            <td><i class="@GetStatusClass(item)" title="@GetStatusHint(item)"></i></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
