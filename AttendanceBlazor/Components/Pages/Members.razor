@page "/members"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAttendanceManager AttendanceManager

<PageTitle>Member Search | RRGC Attendance</PageTitle>

@code {

    public MembersSearchViewModel Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Model = await LoadModelData();
    }

    private async Task<MembersSearchViewModel> LoadModelData()
    {
        var data = await AttendanceManager.GetMembers();
        var model = new MembersSearchViewModel(data);
        model.FilterText = Model.FilterText;
        return model;
    }


    private Timer? _debounceTimer;

    private void OnFilterTextChanged(ChangeEventArgs e)
    {
        // Use a 300ms debounce to avoid excessive filtering while typing
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ => {
            Model.FilterText = e.Value?.ToString() ?? string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 300, Timeout.Infinite);
    }

}


<div>
    <div class="float-end">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <InputText @bind-Value="Model.FilterText" class="form-control" placeholder="Search..." @oninput="OnFilterTextChanged"></InputText>
        </div>
    </div>
    <h2>Members</h2>
</div>
<div class="table-responsive">
    @if (Model.FilterText.Length < 3)
    {
        <div class="alert alert-info p-3 w-50 my-3 mx-auto text-center">
            <span>
                Enter at least 3 characters into the search criteria
            </span>
        </div>
    }
    else if (!Model.FilteredMembers.Any())
    {
        <div class="alert alert-warning p-3 w-50 my-3 mx-auto text-center">
            <span>
                There are no results matching the search criteria
            </span>
        </div>
    }
    else
    {
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>CRM Person ID<br />Card User Name</th>
                    <th>Card Number</th>
                    <th>Member Name</th>
                    <th>FAL Number<br />PNZ Number</th>
                    <th>Email<br />Mobile</th>
                    <th>Registration Date<br />End Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.FilteredMembers)
                {
                    <tr>
                        <td>
                            <div>
                                @if (member.PersonId == member.EntraPersonId && (String.IsNullOrWhiteSpace(member.EntraInfo1) || member.FullName == member.EntraInfo1))
                                {
                                    <i class="bi bi-check-circle-fill text-success px-1" />
                                }
                                else if (String.IsNullOrEmpty(member.EntraCardNumber))
                                {
                                    <i class="bi bi-question-circle text-success px-1" />
                                }
                                else
                                {
                                    <i class="bi bi-exclamation-triangle text-danger px-1" />
                                }
                                @member.PersonId
                            </div>
                            @if (member.PersonId != member.EntraPersonId)
                            {
                                if (member.PersonId != null && member.EntraPersonId != null)
                                {
                                    <div class="small text-danger"><b>EntraPass:</b> @member.EntraCardUserName</div>
                                }
                            }
                        </td>
                        <td>
                            @if (String.IsNullOrWhiteSpace(member.EntraCardNumber))
                            {
                                <div class="text-secondary">Access card unused</div>
                            }
                            else
                            {
                                <div><NavLink href="@("/cards/" + member.EntraCardNumber)">@member.EntraCardNumber</NavLink></div>
                            }

                            @if (member.EntraCardNumber != member.SportyCardNumber)
                            {
                                <div><b>CRM:</b> @member.SportyCardNumber</div>
                            }
                        </td>
                        <td>
                            <div>@member.FullName</div>
                            @if(!String.IsNullOrWhiteSpace(member.EntraInfo1) && member.FullName != member.EntraInfo1.Trim())
                            {
                                <div class="small text-danger"><b>EntraPass:</b> @member.EntraInfo1</div>
                            }
                        </td>
                        <td>
                            <div><b>FAL:</b> @member.FALNumber</div>
                            @if (!String.IsNullOrWhiteSpace(member.PNZNumber))
                            {
                                <div>
                                    <b>PNZ: </b><NavLink href="@("/attendance/" + member.PNZNumber)">@member.PNZNumber</NavLink>
                                </div>
                            }
                        </td>
                        <td>
                            <div><a href="@("mailto:" + member.EmailAddress)">@member.EmailAddress</a></div>
                            <div>@member.MobileNumber</div>
                        </td>
                        <td>
                            @if (member.RegistrationDate < DateTime.Today.AddMonths(-14))
                            {
                                <div class="text-danger"><i class="bi bi-x-circle-fill" /> <b>Reg:</b> @member.RegistrationDate?.ToString("dd/MM/yyyy")</div>
                            }
                            else
                            {
                                <div class="text-success"><i class="bi bi-check-circle-fill" /> <b>Reg:</b> @member.RegistrationDate?.ToString("dd/MM/yyyy")</div>
                            }

                            @if (member.EntraEndDate < DateTime.Today)
                            {
                                <div class="text-danger"><i class="bi bi-x-circle-fill" /> <b>End:</b> @member.EntraEndDate?.ToString("dd/MM/yyyy")</div>
                            }
                            else
                            {
                                <div class="text-success"><i class="bi bi-check-circle-fill" /> <b>End:</b> @member.EntraEndDate?.ToString("dd/MM/yyyy")</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

