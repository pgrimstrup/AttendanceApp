@page "/UploadSporty"
@rendermode InteractiveServer
@inject ISportyRegistrationImporter Importer
@inject IJSRuntime JS

<PageTitle>Upload Sporty CSV | RRGC Attendance</PageTitle>
<AuthorizeView Roles="Admin">
    <NotAuthorized>
        <AttendanceBlazor.Components.Parts.LoginComponent ReturnUrl="/UploadSporty">
        </AttendanceBlazor.Components.Parts.LoginComponent>
    </NotAuthorized>
    <Authorized>
        <h3>Upload Sporty CSV</h3>

        <div class="my-3">
            <label for="File" class="form-label">Choose CSV File:</label>
            <InputFile OnChange="HandleFileSelected" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(UploadMessage))
        {
            <div class="alert @AlertType mt-3">@UploadMessage</div>
        }


    </Authorized>
</AuthorizeView>

@code {
    public string? UploadMessage;
    public string? AlertType;
    public bool CreateTestData { get; set; }

    public async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        UploadMessage = null;

        if (file == null)
        {
            AlertType = "alert-warning";
            UploadMessage = "No file selected.";
            return;
        }

        if (file.ContentType != "text/csv")
        {
            AlertType = "alert-warning";
            UploadMessage = "Please upload a valid CSV file.";
            return;
        }

        AlertType = "alert-info";
        UploadMessage = $"File {e.File.Name} selected, processing...";
        StateHasChanged();

        try
        {
            // Read the file content
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB limit
            using var mem = new MemoryStream();
            await stream.CopyToAsync(mem);
            mem.Position = 0;

            if (await Importer.Import(mem))
            {
                AlertType = "alert-success";
                UploadMessage = $"File '{file.Name}' uploaded and processed successfully.";
            }
            else
            {
                AlertType = "alert-danger";
                UploadMessage = $"File '{file.Name}' could not be processed. Ensure it is in the expected format.";
            }
        }
        catch (Exception ex)
        {
            AlertType = "alert-danger";
            UploadMessage = $"Error uploading file: {ex.Message}";
        }
    }

}
