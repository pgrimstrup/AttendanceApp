@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IAttendanceManager AttendanceManager

@code {
    [Parameter]
    public DateTime? FromDate { get; set; } 

    [Parameter]
    public DateTime? ToDate { get; set; } 

    bool UseFromDate { get; set; } = true;
    bool UseToDate { get; set; }
    bool OrderDescending { get; set; }
    string FilterText { get; set; } = "";

    List<MemberRecord> Activity = new();
    IEnumerable<MemberRecord> FilteredActivity
    {
        get
        {
            foreach (var record in Activity)
            {
                var text = $"{record.EntraCardNumber}|{record.EntraCardUserName}|{record.FullName}|{record.EntraInfo1}|{record.EntraLocation}|{record.PersonId}|{record.SportyCardNumber}|{record.EntraInfo1}|{record.PNZNumber}";
                if (String.IsNullOrWhiteSpace(FilterText) || text.Contains(FilterText, StringComparison.OrdinalIgnoreCase))
                    yield return record;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Activity = await LoadModelData();
    }

    private async Task DoSearchClicked()
    {
        Activity = await LoadModelData();
    }

    private async Task<List<MemberRecord>> LoadModelData()
    {
        DateTime endDate = new DateTime(DateTime.Today.Year + 1, 7, 1);
        DateTime startDate = new DateTime(DateTime.Today.Year, 7, 1);
        if (DateTime.Today.Month < 7)
        {
            startDate = startDate.AddYears(-1);
            endDate = endDate.AddYears(-1);
        }

        if (UseFromDate)
        {
            if(FromDate == null)
                FromDate = DateTime.Today.AddDays(-7);
            startDate = FromDate.Value;
        }
        if (UseToDate)
        {
            if(ToDate == null)
                ToDate = DateTime.Today;
            endDate = ToDate.Value;
        }

        var result = await AttendanceManager.GetRangeActivity(startDate, endDate);
        if (OrderDescending)
        {
            return result
                .OrderByDescending(a => a.EventTime)
                .ThenBy(a => a.EntraCardNumber)
                .ToList();
        }

        return result
            .OrderBy(a => a.EventTime)
            .ThenBy(a => a.EntraCardNumber)
            .ToList();
    }

    private Timer? _debounceTimer;

    private void OnFilterTextChanged(ChangeEventArgs e)
    {
        // Use a 300ms debounce to avoid excessive filtering while typing
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(_ => {
            FilterText = e.Value?.ToString() ?? string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 300, Timeout.Infinite);
    }

}

<h3>Activity Search</h3>

<div class="row">
    <div class="col-3">
        <div class="form-check">
            <label class="form-check-label"><InputCheckbox class="form-check-input" @bind-Value="UseFromDate"></InputCheckbox> From Date</label>
        </div>
        <InputDate @bind-Value="FromDate" class="form-control" disabled="@(!UseFromDate)"></InputDate>
    </div>
    <div class="col-3">
        <div class="form-check">
            <label class="form-check-label"><InputCheckbox class="form-check-input" @bind-Value="UseToDate"></InputCheckbox> To Date</label>
        </div>
        <InputDate @bind-Value="ToDate" class="form-control" disabled="@(!UseToDate)"></InputDate>
    </div>
    <div class="col-3">
        <div class="form-check">
            <label class="form-check-label"><InputCheckbox class="form-check-input" @bind-Value="OrderDescending"></InputCheckbox> Reversed order</label>
        </div>
        <button class="btn btn-primary" @onclick="async () => await DoSearchClicked()">Search</button>
    </div>
    <div class="col-3">
        <div class="float-end">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <InputText @bind-Value="FilterText" class="form-control" placeholder="Filter..." @oninput="OnFilterTextChanged"></InputText>
            </div>
        </div>
    </div>
</div>

<ActivityTable Activity="FilteredActivity.ToList()" />

